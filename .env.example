# Copy this file to .env and set a real key. Never commit .env.

# Required for Gemma analysis (Google AI Studio)
GEMINI_API_KEY=your_api_key_here

# Optional. Official hosted Gemma 4 instruction-tuned MoE model.
GEMINI_MODEL=gemma-4-26b-a4b-it

# Optional HTTP settings
PORT=3000
# Set this to your public origin in production, e.g. https://example.com
CORS_ORIGIN=http://localhost:3000
ANALYZE_TIMEOUT_MS=90000
